# wsj27-auth-api configuration.
# Copy to src/.env for local development. Commented lines show the default.

# --- Public identity of this service -----------------------------------------

# External base URL, including the base path the ingress serves us on.
# Production: https://app.wsj.se/auth
PUBLIC_URL=http://localhost:8000/

# Hosts we are willing to redirect back to, comma-separated. Include the port
# when it is not the scheme default. Scheme and path are not checked.
ALLOWED_REDIRECT_DOMAINS=localhost:8000,localhost:5173

# --- Upstream Keycloak --------------------------------------------------------

# The realm issuer URL; "/.well-known/openid-configuration" is appended.
OIDC_SERVER=https://dev.id.scouterna.se/realms/wsj27
OIDC_CLIENT_ID=wsj27-auth
OIDC_CLIENT_SECRET=

# --- Our own token signing ----------------------------------------------------

# RSA private key, PEM. Generate one with:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048
# Multi-line values work in a .env file if quoted; "\n" escapes are also accepted.
# In production this comes from a k8s secret, never from a file in the image.
SIGNING_KEY=

# Optional. A key that is still trusted for verification but no longer used to
# sign, so a rotation does not invalidate tokens already issued. To rotate:
# move SIGNING_KEY here, put the new key in SIGNING_KEY, and drop this value
# once ACCESS_TOKEN_TTL_SECONDS has elapsed.
#SIGNING_KEY_PREVIOUS=

# The `aud` claim we stamp on minted tokens, and require when verifying them.
#AUDIENCE=wsj27

# How long our access token is valid. The frontend refreshes shortly before this.
#ACCESS_TOKEN_TTL_SECONDS=300

# Used when Keycloak omits the non-standard refresh_expires_in field.
#DEFAULT_REFRESH_EXPIRES_IN=1800

# --- Roles --------------------------------------------------------------------

# How often the Scoutnet role cache is rebuilt.
#ROLE_SYNC_INTERVAL_MINUTES=60

# wsj27-project-api, which tells us who is registered for the project and in
# what capacity. In the cluster this is a Service DNS name — the endpoint we
# call is private and never goes through the ingress.
#PROJECT_API_URL=http://wsj27-project-api
#PROJECT_API_TIMEOUT=15.0

# Which service-account client to mint a token as when calling project-api.
# It needs an entry in SERVICE_CLIENT_ROLES below granting the role that
# project-api requires (wsj27:bulkread).
#PROJECT_API_CLIENT_ID=wsj27-auth

# Dev only: seed the role cache from a JSON file of {"member_no": ["role", ...]}
# so role-dependent consumers are testable before Scoutnet is connected.
#STUB_ROLES_FILE=../dev-roles.json

# Roles granted to any authenticated user with no entry of their own.
# Comma-separated. A role containing a colon ("wsj27-app:admin") becomes a
# client role under resource_access; anything else is a realm role.
#DEFAULT_ROLES=

# Client id used for the resource_access block of minted tokens.
#ROLE_CLIENT_ID=wsj27-app

# --- Service accounts (machine-to-machine callers) ----------------------------

# Backends that call WSJ27 APIs on their own behalf get a token from POST /token
# using the client-credentials grant. Their credentials live here rather than in
# the upstream Keycloak, which is a generic member-authentication platform and
# deliberately holds nothing project-specific.
#
# Two JSON objects, split by sensitivity: roles are ordinary config (ConfigMap in
# k8s), secrets are not (Secret). A client needs an entry in both to be usable.
#
# A role containing a colon becomes a client role under resource_access;
# anything else is a realm role.
#SERVICE_CLIENT_ROLES={"wsj27-reports": ["wsj27-participant", "wsj27-reports:read"]}
#SERVICE_CLIENT_SECRETS={"wsj27-reports": "generate-a-long-random-string"}

# Longer than the browser token: there is no refresh loop behind these.
#SERVICE_TOKEN_TTL_SECONDS=3600

# --- Dev only: skip the identity provider -------------------------------------

# A JSON object of identity claims, as the IdP would have returned them. When
# set, /login signs this user straight in and /refresh re-mints for them; the
# IdP is not contacted at all, not even for discovery at startup, so the apps
# can be tested without a working Keycloak client.
#
# Everything after authentication is unchanged: the member number is read from
# these claims, roles are looked up for it, and the same cookies are set. Give
# a "sub" or a "preferred_username" — the member number comes from the latter.
#
# Anyone who reaches /login is signed in as this user. Never set it in a
# deployed environment.
#FAKE_USER_ID={"name": "Test Testsson", "preferred_username": "1234567@scoutnet", "given_name": "Test", "family_name": "Testsson", "email": "test@example.se"}

# --- Dev only: impersonation --------------------------------------------------

# Lets a signed-in user holding IMPERSONATOR_ROLE become another member — their
# member number and roles — via POST /impersonate, for testing and demos. The
# session is replaced outright; logging out is the only way back. With this off
# the route does not exist. Never set it in production.
#ALLOW_IMPERSONATION=false

# The role that permits it, granted by project-api like any other. Any role
# beneath it counts too: "wsj27:cmt" admits "wsj27:cmt:admin:medlem". Required
# when ALLOW_IMPERSONATION is set.
#IMPERSONATOR_ROLE=

# Fixed lifetime of an impersonation; refreshing does not extend it.
#IMPERSONATION_TTL_SECONDS=1800

# --- Serving ------------------------------------------------------------------

#ROOT_PATH=
#PORT=8000
#DEBUG=false

# Drop the Secure cookie attribute so cookies work over plain HTTP.
# Local development only — never set this in production.
#INSECURE_COOKIES=false
